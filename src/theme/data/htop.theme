# HTOP Color Configuration Template
# This template generates a custom htoprc configuration with themed colors
# Colors are defined using terminal color codes (0-255) or RGB hex values

# htoprc configuration with custom colors
fields=0 48 17 18 38 39 40 2 46 47 49 1
sort_key=46
sort_direction=-1
tree_sort_key=0
tree_sort_direction=1
hide_kernel_threads=1
hide_userland_threads=0
shadow_other_users=0
show_thread_names=0
show_program_path=1
highlight_base_name=0
highlight_deleted_exe=1
highlight_megabytes=1
highlight_threads=1
highlight_changes=0
highlight_changes_delay_secs=5
find_comm_in_cmdline=1
strip_exe_from_cmdline=1
show_merged_command=0
tree_view=0
tree_view_always_by_pid=0
all_branches_collapsed=0
header_margin=1
detailed_cpu_time=0
cpu_count_from_one=0
show_cpu_usage=1
show_cpu_frequency=0
show_cpu_temperature=0
degree_fahrenheit=0
update_process_names=0
account_guest_in_cpu_meter=0
color_scheme=6

# Custom color definitions using template variables
# Main interface colors
color_background=#{{ surface.hex }}
color_text=#{{ onSurface.hex }}
color_highlight=#{{ primary.hex }}
color_selected=#{{ surfaceContainer.hex }}

# CPU meter colors (gradient)
color_cpu_low=#{{ green.hex }}
color_cpu_med=#{{ yellow.hex }}
color_cpu_high=#{{ red.hex }}

# Memory meter colors
color_mem_used=#{{ blue.hex }}
color_mem_buffers=#{{ teal.hex }}
color_mem_cache=#{{ sapphire.hex }}
color_mem_available=#{{ green.hex }}

# Process list colors
color_process_normal=#{{ onSurface.hex }}
color_process_running=#{{ green.hex }}
color_process_sleeping=#{{ outline.hex }}
color_process_zombie=#{{ red.hex }}
color_process_stopped=#{{ yellow.hex }}

# Header and border colors
color_header=#{{ onSurfaceVariant.hex }}
color_border=#{{ outline.hex }}
color_separator=#{{ outlineVariant.hex }}

# Function key colors
color_function_key=#{{ tertiary.hex }}
color_function_desc=#{{ onSurface.hex }}

# Tree view colors
color_tree_line=#{{ outline.hex }}
color_tree_collapsed=#{{ primary.hex }}
color_tree_expanded=#{{ secondary.hex }}

# Load average colors
color_load_low=#{{ green.hex }}
color_load_med=#{{ yellow.hex }}
color_load_high=#{{ red.hex }}

# Priority colors
color_priority_high=#{{ red.hex }}
color_priority_normal=#{{ onSurface.hex }}
color_priority_low=#{{ outline.hex }}

# Swap meter colors
color_swap_used=#{{ maroon.hex }}
color_swap_cache=#{{ peach.hex }}

# Temperature colors (if enabled)
color_temp_cool=#{{ green.hex }}
color_temp_warm=#{{ yellow.hex }}
color_temp_hot=#{{ red.hex }}
